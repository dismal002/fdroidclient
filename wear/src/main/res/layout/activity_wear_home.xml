<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wear_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="14dp"
            android:paddingEnd="26dp"
            android:paddingBottom="26dp">

            <ImageView
                android:id="@+id/search_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/wear_search_circle"
                android:clickable="true"
                android:contentDescription="@string/wear_search"
                android:focusable="true"
                android:padding="11dp"
                android:src="@drawable/ic_search_wear" />

            <LinearLayout
                android:id="@+id/clusters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/wear_syncing"
        android:textColor="@color/wear_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
