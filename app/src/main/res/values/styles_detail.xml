<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="DetailsButtonStyle" parent="Widget.App.Button.OutlinedButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="textAllCaps">true</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.DetailsButton</item>
        <item name="android:stateListAnimator">@null</item>  <!-- no elevation change on hover -->
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- Play's filled green action button (INSTALL / UPDATE) -->
    <style name="DetailsPrimaryButtonStyle" parent="Widget.App.Button">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.DetailsButton</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.PlayButton</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ThemeOverlay.App.DetailsButton" parent="" />

    <style name="DetailsPrimaryButtonStyleSmall" parent="DetailsPrimaryButtonStyle">
        <item name="android:textSize">12sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <!-- Play's outlined UNINSTALL / OPEN button next to the filled one -->
    <style name="DetailsSecondaryButtonStyle" parent="DetailsButtonStyle">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.DetailsButton</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.PlayButton</item>
        <item name="strokeColor">@color/play_button_outline</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/play_green</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="DetailsSecondaryButtonStyleSmall" parent="DetailsSecondaryButtonStyle">
        <item name="android:textSize">12sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="DetailsMoreButtonStyle" parent="Widget.App.Button.TextButton">
        <item name="android:padding">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.DetailsButton</item>
    </style>

    <style name="DetailsAppTitleStyle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/play_fg_primary</item>
    </style>

    <!-- Developer line under the app name -->
    <style name="DetailsAppAuthorStyle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/play_fg_secondary</item>
    </style>

    <!-- Section headings such as "About this app" and "Screenshots" -->
    <style name="DetailsSectionHeaderStyle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/play_fg_primary</item>
        <item name="android:textStyle">bold</item>
    </style>


    <style name="DetailsLastUpdatedStyle" parent="TextAppearance.MaterialComponents.Caption" />

    <style name="DetailsAntiFeaturesWarningStyle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textStyle">bold</item>
    </style>

</resources>