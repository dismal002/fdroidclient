<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Trust manually installed certificates as well as the system ones, so a
         user-installed CA (for an intercepting proxy or a self-signed repo) works. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
