<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/play_page"
        android:orientation="vertical">

        <!-- Green store bar with the search field and tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/play_green"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/search_field"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_phone_search"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/menu_button"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/phone_menu"
                    android:focusable="true"
                    android:src="@drawable/ic_menu"
                    android:tint="#ff757575" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/brand"
                    android:textColor="#ff757575"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/search_mic"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mic"
                    android:tint="#ff757575" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabs_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tab_apps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="24dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:paddingBottom="10dp"
                    android:text="@string/phone_tab_apps"
                    android:textAllCaps="true"
                    android:textColor="#ffffffff"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tab_categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:paddingBottom="10dp"
                    android:text="@string/phone_tab_categories"
                    android:textAllCaps="true"
                    android:textColor="#b3ffffff"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:id="@+id/tab_indicator"
                android:layout_width="64dp"
                android:layout_height="3dp"
                android:layout_marginStart="16dp"
                android:background="#ffffffff" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/apps_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/index_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/play_page"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/play_text_secondary"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:id="@+id/chips_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/play_page"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                </HorizontalScrollView>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="24dp" />
                </ScrollView>
            </LinearLayout>

            <ScrollView
                android:id="@+id/categories_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/play_page"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/categories_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- Slide-out navigation, as in the reference screenshot -->
    <ScrollView
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/play_card"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/drawer_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>
