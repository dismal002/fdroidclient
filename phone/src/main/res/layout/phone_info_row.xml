<?xml version="1.0" encoding="utf-8"?>
<!-- One permission or anti-feature row: icon, title and a short explanation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/info_row_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:importantForAccessibility="no"
        android:tint="@color/play_text_secondary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/info_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/play_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/info_row_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/play_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
