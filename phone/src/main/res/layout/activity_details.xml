<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:focusable="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="@dimen/details_hero_height"
                android:background="@color/card_image_background">

                <ImageView
                    android:id="@+id/hero_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:importantForAccessibility="no" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/hero_scrim" />

                <FrameLayout
                    android:id="@+id/hero_play"
                    android:layout_width="@dimen/details_play_button_size"
                    android:layout_height="@dimen/details_play_button_size"
                    android:layout_gravity="center"
                    android:background="@drawable/play_button_bg"
                    android:clickable="true"
                    android:contentDescription="@string/action_trailer"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_play" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/details_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/details_panel"
                android:orientation="horizontal"
                android:paddingStart="@dimen/details_margin_start"
                android:paddingTop="22dp"
                android:paddingEnd="@dimen/details_margin_end"
                android:paddingBottom="40dp">

                <ImageView
                    android:id="@+id/poster"
                    android:layout_width="@dimen/details_poster_size"
                    android:layout_height="@dimen/details_poster_size"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="38dp">

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/actions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/details_title_size"
                        tools:text="F-Droid" />

                    <TextView
                        android:id="@+id/author"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp"
                        tools:text="F-Droid Limited" />

                    <LinearLayout
                        android:id="@+id/badges"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="4dp"
                        android:maxLines="8"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/details_body_size"
                        tools:text="F-Droid is an installable catalogue of FOSS applications for the Android platform." />

                    <TextView
                        android:id="@+id/footer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:textColor="#80eeeeee"
                        android:textSize="13sp"
                        tools:text="Version 1.21 · 12 MB · GPL-3.0-or-later" />

                    <TextView
                        android:id="@+id/antifeatures_header"
                        style="@style/TvDetailsSectionHeader"
                        android:text="@string/details_antifeatures"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/antifeatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/permissions_header"
                        style="@style/TvDetailsSectionHeader"
                        android:text="@string/details_permissions"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/permissions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/details_loading"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
