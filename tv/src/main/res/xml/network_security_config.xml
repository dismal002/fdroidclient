<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Android TV does not let users install their own certificates, so the
         ISRG Root X1 anchor (Let's Encrypt) ships with the app. User anchors stay
         trusted as well, for proxies and self-signed repositories. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/isrgrootx1" />
        </trust-anchors>
    </base-config>
</network-security-config>
